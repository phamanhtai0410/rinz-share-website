<!DOCTYPE html>
<html lang="en">
<head> 
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0">
    <meta property="og:url" content="https://rinzworld.com/<%= type %>/<%= id %>" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content="Track <%= detail.title %>"/>
    <meta property="og:description" content="Khám phá nhiều hơn tại RinZ" />
    <meta property="og:image" content="<%= detail.banner %>" />
    <meta name="turbolinks-cache-control" content="no-cache">

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0">
    <meta name="turbolinks-cache-control" content="no-cache">
    <title>Track <%= detail.title %></title>
    <link rel="icon" type="image/x-icon" href="/assets/img/share_website/logo.png" />
    <!-- Google fonts-->
    <link href="/template/fonts/SVN-Gilroy.otf" rel='stylesheet' type='text/css' />
    <!-- <link href="https://fonts.googleapis.com/css?family=Lora:400,400i,700,700i" rel="stylesheet" /> -->
    <!-- Core theme CSS (includes Bootstrap)-->
    <link href="/template/css/styles.css" rel="stylesheet" />
    <link href="/template/css/styles.scss" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <!-- Latest compiled and minified CSS -->
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">

    <!-- jQuery library -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>



    <!-- Latest compiled JavaScript -->
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
    <style>
        @font-face {
            font-family: --font;
            src: url(/template/fonts/SVN-Gilroy.otf);
        }
        body {
            font-family: --font;
        }

        .share-content {
            text-align: left;
        }

        .title {
            font-size: 24px;
            font-weight: 700;
            line-height: 32px;
            padding: 30px 0px;
            text-transform: uppercase;
            color: #FEBA08;
        }

        .banner {
            margin-top: 100px;
            max-width: 30vw;
        }
        .banner img {
            width: 100%;
            margin-bottom: 40px;
        
        }

        .author_name {
            font-style: normal;
            font-weight: 500;
            font-size: 24px;
            line-height: 32px;
            text-align: left;
            color: #FEBA08;
            margin-top: 37px;
        }
        
        .text_white {
            font-style: normal;
            font-weight: normal;
            font-size: 20px;
            line-height: 28px;
            text-align: center;
            color: #E8E8E8;
            margin-bottom: 100px;
        }

        .download-content {
            text-align: center;
            margin-top: 100px;
        }

        .download-title {
            font-style: normal;
            font-weight: bold;
            font-size: 24px;
            line-height: 133.69%;
            color: #FEBA08;
        }

        .download-btn > a img {
            max-width: 240px;
            margin-top: 24px;
            margin-right: 24px;
        }

        .track-title {
            font-style: normal;
            font-weight: bold;
            font-size: 38px;
            line-height: 46px;
            color: #FEBA08;
        }

        .listen-now-btn {
            margin-top: 65px;
        }

        .listen-now-btn > a img {
            max-width: 170px;
        }

        #mobile {
            display: none;
            text-align: center;
        }

        .download-content-mobile {
            text-align: center;
            margin-top: 35%;
            margin-bottom: 12%;
        }

        @media only screen and (max-device-width: 480px) {
            #mobile {
                display: block;
                
            }

            body {
                background-image: url(/assets/img/share_website/mobile_background.png);
            }

            #desktop {display: none;}
        }

        @media only screen and (min-device-width: 480px) {
            body {
                background-image: url(/assets/img/share_website/background.png);
                padding: 50px 100px;
            }
        }

        .mobile-banner img {
            max-width: 200px;
            max-height: 200px;
            margin-top: 50%;
            margin-bottom: 24px;
        }

        .author_name_mobile {
            font-family: --font;
            color: #E8E8E8;
            font-style: normal;
            font-weight: bold;
            font-size: 18px;
            line-height: 28px;
            margin-bottom: 6px;
            margin-left: auto;
            margin-right: auto;
            width: 60%;
            overflow: hidden;
            display: -webkit-box !important;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
        }
       
        .text-mobile {
            font-style: normal;
            font-weight: normal;
            font-size: 16px;
            line-height: 20px;
            text-align: center;
            color: #BFBFBF;
        }

        .download-title-mobile {
            font-style: normal;
            font-weight: 600;
            font-size: 18px;
            line-height: 28px;
            color: #E8E8E8;
            margin-bottom: 16px;
        }

        .download-btn-mobile > a img {
            max-width: 170px;
        }
    </style>

</head>
<body>
    
    <div id="desktop">
        <div class="w-100">
            <div class="share-content">
                <div class='logo text-left row'>
                    <img src="/assets/img/share_website/logo.png" style="max-width: 160px;" alt="RinZ Network">
                </div>
                <div class="row">
                    <div class="banner col-4">
                        <img src="<%= detail.banner %>?w=450" alt="Banner">
                    </div>
                    <div class="col-6" style="margin-top: 100px; margin-left: 5%;">
                        <div class='track-title'>
                            <%= detail.title %>
                        </div>
                        <div class="author_name">
                            <%=  detail.author_name %>
                        </div>
                        <div class="listen-now-btn">
                            <a href="#"><img src="/assets/img/share_website/listen_now_btn.png" alt=""></a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="download-content">
                <div class="download-title text-left">
                    TẢI APP NGAY ĐỂ KHÁM PHÁ
                </div>
                <div class="d-flex justify-content-start">
                    <div class="download-btn">
                        <a href="https://apps.apple.com/us/app/thecuatui/id1568831849"><img src="/assets/img/share_website/appstore.png" alt=""></a>
                    </div>
                    <div class="download-btn">
                        <a href="https://play.google.com/store/apps/details?id=com.thecuatui"><img src="/assets/img/share_website/googleplay.png" alt=""></a>
                    </div>
                </div>
            </div>           
        </div>
    </div>
    <div id="mobile">
        <div class="mobile-banner">
            <img src="<%= detail.banner %>?w=200" alt="Banner">
        </div>
        <div class="">
            <p class="author_name_mobile d-flex justify-content-center">
                <%= detail.title %>
            </p>
        </div>
        <div class="text-mobile">
            <%= detail.author_name %>
        </div>
        <div class="download-content-mobile">
            <div class="download-title-mobile">
                TẢI APP NGAY ĐỂ KHÁM PHÁ
            </div>
            <div class="row">
                <div class="download-btn-mobile col text-right">
                    <a href="https://apps.apple.com/us/app/thecuatui/id1568831849"><img src="/assets/img/share_website/appstore.png" alt=""></a>
                </div>
                <div class="download-btn-mobile col text-left">
                    <a href="https://play.google.com/store/apps/details?id=com.thecuatui"><img src="/assets/img/share_website/googleplay.png" alt=""></a>
                </div>
            </div>
        </div>
    </div>
</body>
   
</html>