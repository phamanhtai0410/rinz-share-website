        }

        #custom-tooltip-key, #custom-tooltip-server, #custom-tooltip-username, #custom-tooltip-password {
            display: none;
            margin-left: 10px;
            padding: 4px 12px;
            background-color: #000000df;
            border-radius: 4px;
            color: #fff;
        }
