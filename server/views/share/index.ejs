            font-weight: 600;
            font-size: 18px;
            line-height: 28px;
            color: #E8E8E8;
            margin-bottom: 16px;
        }

        .download-btn-mobile > a img {
            max-width: 170px;
        }

        .stream-info {
            margin-top: 14vh;
            text-align: center;
        }

        .stream-tutorial img{
