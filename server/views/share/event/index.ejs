<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0">
    <meta property="og:url" content="https://rinzworld.com/<%= type %>/<%= id %>" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content="Event <%= detail.title %>" />
    <meta property="og:description" content="Khám phá nhiều hơn tại RinZ" />
    <meta property="og:image" content="<%= detail.banner %>" />
    <meta name="turbolinks-cache-control" content="no-cache">

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0">
    <meta name="turbolinks-cache-control" content="no-cache">
    <title>Event
        <%= detail.title %>
    </title>
    <link rel="icon" type="image/x-icon" href="/assets/img/share_website/logo.png" />
    <!-- Google fonts-->
    <link href="/template/fonts/SVN-Gilroy.otf" rel='stylesheet' type='text/css' />
    <!-- <link href="https://fonts.googleapis.com/css?family=Lora:400,400i,700,700i" rel="stylesheet" /> -->
    <!-- Core theme CSS (includes Bootstrap)-->
    <link href="/template/css/styles.css" rel="stylesheet" />
    <link href="/template/css/styles.scss" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <!-- Latest compiled and minified CSS -->
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">

    <!-- jQuery library -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>



    <!-- Latest compiled JavaScript -->
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
    <style>
        @font-face {
            font-family: --font;
            src: url(/template/fonts/SVN-Gilroy.otf);
        }
        
        body {
            font-family: --font;
        }
        
        .share-content {
            text-align: center;
        }
        
        .title {
            font-size: 24px;
            font-weight: 700;
            line-height: 32px;
            padding: 30px 0px;
            text-transform: uppercase;
            color: #FEBA08;
        }
        
        .banner img {
            max-width: 270px;
            max-height: 300px;
            margin-bottom: 25px;
        }
        
        .author_name {
            color: #FEBA08;
            font-size: 20px;
            font-weight: 600;
            line-height: 133.69%;
        }
        
        .counter-title {
            margin-top: 85px;
            margin-bottom: 40px;
            color: #FEBA08;
            font-weight: 700;
            font-size: 36px;
            line-height: 133.69%;
        }
        
        .counter {
            text-align: center;
        }
        
        .counter-dhms {
            margin: 0 auto;
            max-width: 650px;
        }
        
        .counter-items {
            margin: 0 auto;
        }
        
        .counter-number p {
            font-size: 72px;
            line-height: 133.69%;
            font-weight: bold;
            color: #FFFFFF;
            text-align: center;
            font-family: --font;
        }
        
        .counter-legend p {
            padding-top: 10px;
            font-size: 18px;
            font-weight: 500;
            color: white;
            line-height: 21px;
            text-align: center;
            font-family: --font;
        }
        
        .subcribe-btn {
            margin-top: 60px;
        }
        
        .subcribe-btn>a img {
            max-width: 150px;
        }
        
        .download-content {
            text-align: left;
            margin-top: 100px;
        }
        
        .download-title {
            font-style: normal;
            font-weight: bold;
            font-size: 24px;
            line-height: 133.69%;
            color: #FEBA08;
        }
        
        .download-btn>a img {
            max-width: 240px;
            margin-top: 24px;
        }
        
        #mobile {
            display: none;
            text-align: center;
        }
        
        .download-content-mobile {
            text-align: center;
            margin-top: 15%;
            margin-bottom: 12%;
        }
        
        @media only screen and (max-device-width: 480px) {
            #mobile {
                display: block;
            }
            body {
                background-image: url(/assets/img/share_website/mobile_background.png);
            }
            #desktop {
                display: none;
            }
        }
        
        @media only screen and (min-device-width: 480px) {
            body {
                background-image: url(/assets/img/share_website/background.png);
                padding: 50px 100px;
            }
        }
        
        .mobile-banner img {
            max-width: 200px;
            max-height: 200px;
            margin-top: 50%;
            margin-bottom: 24px;
        }
        
        .mobile-banner {
            position: relative;
        }
        
        .start-time-mobile {
            position: absolute;
            bottom: 6px;
            left: 25%;
        }
        
        .start-time-mobile p {
            position: absolute;
            bottom: 28px;
            left: 2%;
            font-family: --font;
            font-style: normal;
            font-weight: normal;
            font-size: 11px;
            line-height: 16px;
            color: #FAFAFA;
            flex: none;
            order: 1;
            flex-grow: 0;
            margin: 0px 3px;
        }
        
        .author_name_mobile {
            font-family: --font;
            color: #E8E8E8;
            font-style: normal;
            font-weight: bold;
            font-size: 18px;
            line-height: 28px;
            margin-bottom: 6px;
            margin-left: auto;
            margin-right: auto;
            width: 60%;
            overflow: hidden;
            display: -webkit-box !important;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
        }
        
        .text-mobile {
            font-style: normal;
            font-weight: normal;
            font-size: 16px;
            line-height: 20px;
            text-align: center;
            color: #BFBFBF;
        }
        
        .download-title-mobile {
            font-style: normal;
            font-weight: 600;
            font-size: 18px;
            line-height: 28px;
            color: #E8E8E8;
            margin-bottom: 16px;
        }
        
        .download-btn-mobile>a img {
            max-width: 170px;
        }
        
        .open-in-app-btn>a img {
            max-width: 90%;
        }
        
        .open-in-app-btn {
            padding-top: 15vh;
        }
    </style>

</head>

<body>

    <div id="desktop">
        <div class="w-100">
            <div class="share-content">
                <div class='logo text-left'>
                    <img src="/assets/img/share_website/logo.png" style="max-width: 160px;" alt="RinZ Network">
                </div>
                <div class="content-detail text-center">
                    <div class="title">
                        <%= detail.title %>
                    </div>
                </div>
                <div class="banner">
                    <img src="<%= detail.banner %>?w=270" alt="Banner">
                </div>
                <div class="author_name">
                    <%=  detail.author_name %>
                </div>
                <div class="counter">
                    <div class="counter-title">
                        LIVESTREAM BẮT ĐẦU SAU
                    </div>
                    <div class="counter-dhms row">
                        <div class="counter-items col-3">
                            <div class="counter-number row">
                                <p id="day">--</p>
                            </div>
                            <div class="counter-legend row">
                                <p>NGÀY</p>
                            </div>
                        </div>
                        <div class="counter-items col-3">
                            <div class="counter-number row">
                                <p id="hour">--</p>
                            </div>
                            <div class="counter-legend row">
                                <p>GIỜ</p>
                            </div>
                        </div>
                        <div class="counter-items col-3">
                            <div class="counter-number row">
                                <p id="min">--</p>
                            </div>
                            <div class="counter-legend row">
                                <p>PHÚT</p>
                            </div>
                        </div>
                        <div class="counter-items col-3">
                            <div class="counter-number row">
                                <p id="sec">--</p>
                            </div>
                            <div class="counter-legend row">
                                <p>GIÂY</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="subcribe-btn">
                    <a href="#"><img src="/assets/img/share_website/subcribe.png" alt=""></a>
                </div>
            </div>

            <div class="download-content">
                <div class="download-title row">
                    TẢI APP NGAY ĐỂ KHÁM PHÁ
                </div>
                <div class="row text-left" style="width: 30%;">
                    <div class="download-btn col">
                        <a href="https://apps.apple.com/us/app/thecuatui/id1568831849"><img src="/assets/img/share_website/appstore.png" alt=""></a>
                    </div>
                    <div class="download-btn col">
                        <a href="https://play.google.com/store/apps/details?id=com.thecuatui"><img src="/assets/img/share_website/googleplay.png" alt=""></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="mobile">
        <div class="mobile-banner">
            <img class="mobile-banner-img" src="<%= detail.banner %>?w=200" alt="Banner">
            <div class="start-time-mobile">
                <img src="/assets/img/share_website/start_time_tag.png" alt="" style="max-width: 100px;">
                <p id="start-time-mobile">
                    <%= detail.start_time %>
                </p>
            </div>

        </div>
        <div class="">
            <p class="author_name_mobile d-flex justify-content-center">
                <%= detail.title %>
            </p>
        </div>
        <div class="text-mobile">
            <%= detail.author_name %>
        </div>
        <div class="open-in-app-btn">
            <a href="<%= dynamic_link %>"><img src="/assets/img/share_website/download_btn.png" alt=""></a>
        </div>
        <div class="download-content-mobile">
            <div class="download-title-mobile">
                TẢI APP NGAY ĐỂ KHÁM PHÁ
            </div>
            <div class="row">
                <div class="download-btn-mobile col text-right">
                    <a href="https://apps.apple.com/us/app/thecuatui/id1568831849"><img src="/assets/img/share_website/appstore.png" alt=""></a>
                </div>
                <div class="download-btn-mobile col text-left">
                    <a href="https://play.google.com/store/apps/details?id=com.thecuatui"><img src="/assets/img/share_website/googleplay.png" alt=""></a>
                </div>
            </div>
        </div>
    </div>
</body>
<script>
    $(document).ready(function() {
        var start_time = parseInt("<%= detail.start_time %>") * 1000;
        // console.log('start time =', start_time);
        var x = setInterval(function() {

            // Get today's date and time
            var now = new Date().getTime();
            // console.log('now = ', now)
            // Find the distance between now and the count down date
            var distance = start_time - now;

            // Time calculations for days, hours, minutes and seconds
            var days = Math.floor(distance / (1000 * 60 * 60 * 24));
            var hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            var minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            var seconds = Math.floor((distance % (1000 * 60)) / 1000);

            // Display the result in the element with id="demo"
            document.getElementById("day").innerHTML = days;
            document.getElementById("hour").innerHTML = hours;
            document.getElementById("min").innerHTML = minutes;
            document.getElementById("sec").innerHTML = seconds;


            // If the count down is finished, write some text
            if (distance < 0) {
                clearInterval(x);
                document.getElementById("day").innerHTML = "--";
                document.getElementById("hour").innerHTML = "--";
                document.getElementById("min").innerHTML = "--";
                document.getElementById("sec").innerHTML = "--";
            }
        }, 1000);

        var date = new Date(start_time);
        var month = date.getMonth() < 9 ? "0" + (date.getMonth() + 1) : date.getMonth();
        var day = date.getDate() < 9 ? "0" + date.getDate() : date.getDate();
        var hour = date.getHours() < 9 ? "0" + date.getHours() : date.getHours();
        var min = date.getMinutes() < 9 ? "0" + date.getMinutes() : date.getMinutes();
        document.getElementById("start-time-mobile").innerHTML = day + " THG " + month + " • " + hour + ":" + min;

    });
</script>

</html>