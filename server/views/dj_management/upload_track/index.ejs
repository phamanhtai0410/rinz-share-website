		<script>(function(e,t,n){var r=e.querySelectorAll("html")[0];r.className=r.className.replace(/(^|\s)no-js(\s|$)/,"$1js$2")})(document,window,0);</script>
	</head>
	<div>
		<div class="top__nav row">
			<div class="logo col">
				<a href="/console/upload"><img src="/assets/img/share_website/logo.png" alt="RinZ" style="width: 6vw;"></a>
				
			</div>
			<div class="nav__list row col">
				<div class="upload col">
					<a href="/console/upload">Upload</a>
				</div>
				<div class="create__album col">
					<a id="top__nav__create__album">Tạo Album</a>
				</div>
				<div class="live__stream col">
					<a id="top__nav__list__all">Live Stream</a>
				</div>
				<div class="library col">
					<a id="top__nav__library">Thư viện</a>
				</div>
				<div class="log__in col" id="log__in">
					<a href="/console">Đăng nhập</a>
				</div>
				<div class="log__in col" id="logged__in">
				</div>
				

				
			</div>
		</div>
		
		<div id="container" class="container" role="main">
		
			<form method="post" action="<%= upload_api %>" enctype="multipart/form-data" novalidate="" class="box has-advanced-upload">
				<div class="box__input">
					<img class="box__icon" src="/assets/img/dj_management/upload_icon.png" style="width: 10%; margin: 0px auto;"></img>
					<div class="text__drag">
						Kéo và thả tệp để upload
					</div>
					<div class="accepted__file__types">
						Hổ trợ định dạng mp3, vma, wav
					</div>
					<input type="file" name="files[]" accept=".mp3, .wav, .wma" id="file" class="box__file" data-multiple-caption="{count} files selected" multiple="">
					<label for="file"><div class="choose__file">Chọn file để upload</div></label>
					<button type="submit" class="box__button">Upload</button>
				</div>
				<div class="box__uploading">Đang tải lên…</div>

				<div class="box__success">Hoàn tất! <a href="/console/upload" class="box__restart" role="button">Tải lên thêm?</a></div>
				<div class="box__error">Lỗi! <span></span>. <a href="/console/upload" class="box__restart" role="button">Hãy thử lại!</a></div>
				
				<input type="hidden" name="ajax" value="1">
			</form>
<!-- 
			<footer class="text-left">
				<p><strong>CÔNG TY CP GIẢI PHÁP ESOL</strong></p>
				<p>Giấy phép kinh doanh: 0316829805</p>
				<p>Địa chỉ: 90M Hoàng Quốc Việt, Phường Phú Mỹ, Quận 7, TPHCM</p>
				<p>Hotline: 08719191102</p>
				<p>Email: support@rinz.vn</p>
			</footer> -->
		</div>
		

		<div id="loading__container" class="loading__container">
			<div class="progress__bar__detail row">
				<div id="track_name" class="track__name col text-left">
					Track Name
				</div>
				<div id="loaded_n_total" class="progress__bar__proportion col text-right">
					... of ... đã tải lên
				</div>
			</div>
			
			
			<progress id="progressBar" value="0" max="100" style="width:50vw;"></progress>
			<div class="track__detail">
				<form method="post" action="<%= upload_banner_api %>" class="row" id="track_detail_form">
					<label class="add_track_banner col-5" for="track__banner">
						<img id="track_banner_img" src="/assets/img/dj_management/upload_track_banner.png" class=""alt="Upload Track" style="width: 17vw;">
						
					</label>
					<input type="file" accept=".png, .jpg, .jpeg" class="box__file" id="track__banner">

					
						
					
					<div class="add_track_detail col-7">
						<div class="track_detail_items row">
							<label for="title">Tiêu đề</label>
							<input name="title" type="text" id='title' placeholder="Nhập tiêu đề" required>
						</div>
						<div class="track_detail_items row">
							<label for="danh-muc">Danh mục</label>
							<select id="danh-muc">
								<option value="producer">Producer</option>
							</select>
						</div>
						<div class="track_detail_items row">
							<label for="">Thể loại</label>
							<select name="category" id="category">
								<option value="dance-edm">Dance & EDM</option>
							</select>
						</div>
						<div class="track_detail_items row">
							<label for="description">Mô tả</label>
							<textarea id="description" name="description" rows="7" cols="40" placeholder="Nhập mô tả" style="color: white;"></textarea>
						</div>
						<div class="track_detail_items row">
							<label for="price">Giá bài hát</label>
							<input type="text" id='price' name="price" placeholder="Nhập giá của bài hát">
						</div>

						<div class="track_detail_control_btns">
							<div class="cancel-btn">
								<a href="/console/upload">Hủy</a>
							</div>
							<button class="submit-btn" type="submit" form="track_detail_form" value="Submit">Hoàn tất</button>
							
						</div>
					</div>
					
				</form>
				
				
			</div>
			<div id="track_url"></div>
			<div id="track_banner_url"></div>
		</div>
		<script>
			$(document).ready(function() {

				/// Check LOGIN
				if (!document.cookie.split(';').find(e => e.trim().split('=')[0] == 'BearerToken')) {		
					window.location.replace('/console');
				}
				else if (document.cookie.split(';').find(e => e.trim().split('=')[0] == 'BearerToken').split('=')[1] === "") {
					window.location.replace('/console');
				}
				else {
					document.getElementById('log__in').style.visibility = "hidden";
					document.getElementById('logged__in').style.visibility = "visible";
					document.getElementById('logged__in').innerHTML = `<span style="color:white;">Hello, <span style="color: #FF9E00;">${document.cookie.split(';').find(e => e.trim().split('=')[0] == 'UserFullName').split('=')[1]}</span></span>`;
					
				}


				///// Add list stream link
				var token = document.cookie.split(';').find(e => e.trim().split('=')[0] == 'BearerToken').split('=')[1];
				document.getElementById('top__nav__list__all').href = `/console/stream/_all?time=${Date.now()}`;
				document.getElementById('top__nav__library').href = `/console/library?time=${Date.now()}`;
				document.getElementById('top__nav__create__album').href = `/console/create_album?time=${Date.now()}`;
			});


			
			$(document).on({
				ajaxStart: function(){
					$("body").addClass("loading"); 
				},
				ajaxStop: function(){ 
					$("body").removeClass("loading"); 
				}    
			});

			$("#track__banner").on('change', function(){ 
				readURL(this);
				// Banner of  track
				var uploadBannerFormData = new FormData();
				var file = document.getElementById('track__banner').files[0];
				uploadBannerFormData.append('file', file);

				var ajaxUploadBanner = new XMLHttpRequest();
				var form = document.getElementById('track_detail_form');

				ajaxUploadBanner.onload = function()
				{
					
					if( ajaxUploadBanner.status >= 200 && ajaxUploadBanner.status < 400 )
					{
						console.log(ajaxUploadBanner.responseText );
						var data = JSON.parse( ajaxUploadBanner.responseText );
						if (data.status == 1) {
							var url = data.data.url;
							console.log('url=', url)
							document.getElementById('track_banner_url').innerHTML = url;
							
							
						}
						
						
					}
					else alert( 'Error. Please, contact the webmaster!' );
				};

				ajaxUploadBanner.onerror = function()
				{
					
					alert( 'Error Uploading Banner. Please, try again!' );
				};


				ajaxUploadBanner.open( form.getAttribute( 'method' ), form.getAttribute( 'action' ), true );
				
				ajaxUploadBanner.send(uploadBannerFormData);

			});

			function readURL(input) {
				if (input.files && input.files[0]) {
					var reader = new FileReader();

					reader.onload = function (e) {
						$('#track_banner_img').attr('src', e.target.result);
					}

					reader.readAsDataURL(input.files[0]);
				}
			}

			$("#track_detail_form").on('submit', function(e) {
				e.preventDefault();
				var formdata = new FormData();

				/// url
				formdata.append('url', document.getElementById('track_url').innerHTML);

				/// author_name: hard_code: "producer"
				formdata.append('rzm_author', 'producer');

				/// title
				formdata.append('title', document.getElementById('title').value);
				console.log('title : ', document.getElementById('title').value);

				/// Category - The loai
				formdata.append('category', document.getElementById('category').value);

				// description
				formdata.append('description', document.getElementById('description').value);

				// rz_point
				formdata.append('rz_point', document.getElementById('price').value != '' ? parseInt(document.getElementById('price').value) : 0);

				// Banner Post to storage
				formdata.append('banner', document.getElementById('track_banner_url').innerHTML);
				// post_banner(formdata);

				/// POST TO SERVER to submit track
				


				var ajaxSubmitTrack = new XMLHttpRequest();

				ajaxSubmitTrack.onload = function()
				{
					
					if( ajaxSubmitTrack.status >= 200 && ajaxSubmitTrack.status < 400 )
					{	
						console.log(ajaxSubmitTrack.responseText );
						var data = JSON.parse( ajaxSubmitTrack.responseText );
						window.location.replace(`/console/upload/result?result=success&title=${data.title}&banner=${data.banner}&category=${data.category}&description=${data.description}&rz_point=${data.rz_point}`);	
					}
					else
					{
						console.log(ajaxSubmitTrack.responseText );
						var data = JSON.parse( ajaxSubmitTrack.responseText );
						window.location.replace(`/console/upload/result?result=failed&msg=${data.msg}`);

					} 
					
				};

				ajaxSubmitTrack.onerror = function()
				{
					
					alert( 'Error Submitting Track. Please, try again!' );
				};

				ajaxSubmitTrack.open('post', '/console/upload/submit', true);
				ajaxSubmitTrack.setRequestHeader('Authorization', "Bearer " + document.cookie.split(';').find(e => e.trim().split('=')[0] == 'BearerToken').split('=')[1]);
				ajaxSubmitTrack.send(formdata);



			});

			
				
			
		</script>
		<script type='text/javascript' src="/template/js/dj_management/upload_track/upload.js"></script>

		<script defer="" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon="{&quot;rayId&quot;:&quot;6970d45a5a3224c3&quot;,&quot;token&quot;:&quot;2863ac31b15c48f5b94bd8b0c38aba94&quot;,&quot;version&quot;:&quot;2021.9.0&quot;,&quot;si&quot;:100}"></script>
		
	</body>
</html>