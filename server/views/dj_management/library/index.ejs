                                    <div class="album__item__banner">
                                        <img src="<%= album_list[i].banner[0] %>" onerror="this.onerror=null; this.src='/assets/img/share_website/logo.png'" alt="">
                                    </div>
                                    <div class="album__item__tracks__list">
                                        <% for(let j=0; j < album_list[i].tracks_info.length; j++) { %>
                                            <div class="album__item__track_item">
                                                <div class="album__item__track_item__title">
                                                    <%= album_list[i].tracks_info[j].title %>
                                                </div>
                                                <div class="hyphen">
                                                    &emsp;&#8208;&emsp;
                                                </div>
                                                <div class="album__item__track_item__duration">
                                                    <%= album_list[i].tracks_info[j].duration %>
                                                </div>
                                                <div class="hyphen">
                                                    &emsp;&#8208;&emsp;
                                                </div>
                                                <div class="album__item__track_item__category">
                                                    <%= track_category.find(e => e.id === album_list[i].tracks_info[j].category).name   %>
                                                </div>
                                                <div class="album__item__track_item__price">
                                                    <div class="price__gold__icon">
    
                                                    </div>
                                                    <div class="price__number" style="margin-left: 25%;">
                                                        <% if (album_list[i].tracks_info[j].rz_point / 1000 > 0) { %>
                                                            <%= album_list[i].tracks_info[j].rz_point / 1000 %>K RZP
                                                        <% } else { %>
                                                            <%= "Miễn phí" %>
