        <div class="list__items">
            <div id="track__list">
                <div class="track__category__control d-flex flex-wrap" id="control__track__category">
                    <%  for (let i=0; i < track_category.length; i++ ) { %>
                        <% if (i === 0) { %>
                            <div class="track__category__option__select" id="<%= track_category[i].value %>">
                                <%= track_category[i].name %>
                            </div>
                        <% } else { %>
                            <div class="track__category__option" id="<%= track_category[i].value %>">
                                <%= track_category[i].name %>
                            </div>
                        <% } %>
                    <% } %>
                </div>
                <div class="track__filter__list" id="track__filter__list">
                    <%  for (let i=0; i < track_list.length; i++ ) { %>
                        
                        <div class="track__filter__item" id="<%= track_list[i].id %>">
                            <div class="track__filter__item__border">
                                <div class="track__filter__item__banner">
                                    <img src="<%= track_list[i].banner %>" onerror="this.onerror=null; this.src='/assets/img/share_website/logo.png'" alt="">
                                </div>
                                <div class="track__filter__item__info">
                                    <div class="track__filter__item__info__1">
                                        <div class="track__filter__item__title">
                                            <%= track_list[i].title %>
                                        </div>
                                        <div class="track__filter__item__duration">
                                            <%= track_list[i].duration %>
                                        </div>
                                    </div>      
                                    <div class="track__filter__item__category" category="<%= track_list[i].category %>">
                                        <%= track_category.find(e => e.id === track_list[i].category).name  %>
                                    </div>
                                </div>
                                <div class="track__filter__item__price">
                                    <div class="price__gold__icon">

                                    </div>
                                    <div class="price__number">
                                        <% if (track_list[i].rz_point / 1000 > 0) { %>
                                            <%= track_list[i].rz_point / 1000 %>K RZP
                                        <% } else { %>
                                            <%= "Miễn phí" %>
                                        <% } %>
                                    </div>
                                    
                                </div>           
                            </div>                                                                    
                        </div>      
                    <% } %>
                </div>
            </div>
            <div id="album__list">
