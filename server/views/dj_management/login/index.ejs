        <div class="login__panel">
            <div class="login__title">
                LOGIN WITH OTP
            </div>
            <div class="login__content">
                <form action="" method='get' id="login__form">
                    <div class="items row">
                        <label for="phone">Số điện thoại:</label>  
                        <input placeholder="Nhập số điện thoại..." name="phone" id="phone" type="text" required> 
                    </div>
                    <div class="submit__btn">
                        <button type="submit" form="login__form" value="Submit">LOG IN</button>
                    </div>
                                         
                </form>
            </div>
        </div>
        
        
       
    <script>
		// if (!document.cookie.split(';').find(e => e.split('=')[0] == 'BearerToken')) {		
		// 	// window.location.replace('/dj/login/upload');
		// }
		// else if (document.cookie.split(';').find(e => e.split('=')[0] == 'BearerToken').split('=')[1] !== "") {
		// 	window.location.replace('/dj/login/upload');
		// }

		$(document).ready(function() {
				if (!document.cookie.split(';').find(e => e.trim().split('=')[0] == 'BearerToken')) {		
					// window.location.replace('/dj/login/upload');
				}
				else if (document.cookie.split(';').find(e => e.trim().split('=')[0] == 'BearerToken').split('=')[1] !== "") {
					window.location.replace('/console/upload');
				}
			});

			
        $('#login__form').on('submit', function (e) {
            e.preventDefault();


            
            var phone = document.getElementById('phone').value;
            
            $.ajax({
                url: "/console/submit_phone?phone=" + phone,
                type: 'GET',
                success : function (data){
                    console.log('login gencode resp: ', data);
                    if (data.status === 1) {
                        window.location.replace('/console/input_otp?phone=' + data.phone);
                    }
                }

            });
				
				
        });
    </script>

	</body>
