<!DOCTYPE html>
<html lang="en">
<head> 
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0">
    <meta property="og:url" content="https://rinzworld.com/<%= type %>/<%= id %>" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content="<% detail.name %>" />
    <meta property="og:description" content="Khám phá nhiều hơn tại RinZ World" />
    <meta property="og:image" content="<%= detail.avatar %>" />
    <meta name="turbolinks-cache-control" content="no-cache">

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0">
    <meta name="turbolinks-cache-control" content="no-cache">
    <title>Share: Aritst <%= id %></title>
    <link rel="icon" type="image/x-icon" href="/assets/img/share_website/logo.png" />
    <!-- Google fonts-->
    <link href="/template/fonts/SVN-Gilroy.otf" rel='stylesheet' type='text/css' />
    <!-- <link href="https://fonts.googleapis.com/css?family=Lora:400,400i,700,700i" rel="stylesheet" /> -->
    <!-- Core theme CSS (includes Bootstrap)-->
    <link href="/template/css/styles.css" rel="stylesheet" />
    <link href="/template/css/styles.scss" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <!-- Latest compiled and minified CSS -->
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">

    <!-- jQuery library -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>



    <!-- Latest compiled JavaScript -->
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
    <style>
        @font-face {
            font-family: --font;
            src: url(/template/fonts/SVN-Gilroy.otf);
        }
        body {
            font-family: --font;
        }

        .share-content {
            text-align: center;
        }

        .title {
            font-size: 24px;
            font-weight: 700;
            line-height: 32px;
            padding: 30px 0px;
            text-transform: uppercase;
            color: #FEBA08;
        }

        .banner img {
            max-width: 400px;
            max-height: 400px;
            margin-bottom: 40px;
        }

        .author_name {
            color: #FEBA08;
            font-size: 30px;
            font-weight: 600;
            line-height: 38px;
            margin-bottom: 10px;
        }
        
        .text_white {
            font-style: normal;
            font-weight: normal;
            font-size: 20px;
            line-height: 28px;
            text-align: center;
            color: #E8E8E8;
            margin-bottom: 100px;
        }

        .download-content {
            text-align: center;

        }
        .download-content-mobile {
            text-align: center;
            margin-top: 35%;
            margin-bottom: 12%;
        }

        .download-title {
            font-style: normal;
            font-weight: bold;
            font-size: 24px;
            line-height: 133.69%;
            color: #FEBA08;
        }

        .download-btn > a img {
            max-width: 240px;
            margin-top: 24px;
        }

        #mobile {
            display: none;
        }

        @media only screen and (max-device-width: 480px) {
            #mobile {
                display: block;
                
            }

            body {
                background-image: url(/assets/img/share_website/mobile_background.png);
            }

            #desktop {display: none;}
        }

        @media only screen and (min-device-width: 480px) {
            body {
                background-image: url(/assets/img/share_website/background.png);
                padding: 50px 100px;
            }
        }

        .mobile-banner img {
            max-width: 200px;
            max-height: 200px;
            margin-top: 50%;
            margin-bottom: 24px;
        }

        .author_name_mobile {
            color: #E8E8E8;
            font-style: normal;
            font-weight: bold;
            font-size: 18px;
            line-height: 28px;
            margin-bottom: 6px;
        }
       
        .text-mobile {
            font-style: normal;
            font-weight: normal;
            font-size: 16px;
            line-height: 20px;
            text-align: center;
            color: #BFBFBF;
        }

        .download-title-mobile {
            font-style: normal;
            font-weight: 600;
            font-size: 18px;
            line-height: 28px;
            color: #E8E8E8;
            margin-bottom: 16px;
        }

        .download-btn-mobile > a img {
            max-width: 170px;
        }
    </style>

</head>
<body>
    <div id="desktop">
        <div class="w-100">
            <div class="share-content">
                <div class='logo text-left'>
                    <img src="/assets/img/share_website/logo.png" style="max-width: 160px;" alt="RinZ Network">
                </div>
                <div class="banner">
                    <img style="border-radius: 50%;" src="<%= detail.avatar %>" alt="Banner">
                </div>
                <div class="author_name">
                        <%=  detail.name %>
                </div>
                <div class="text_white">
                    Artist on RinZ Music
                </div>
            </div>
            <div class="download-content">
                <div class="download-title">
                    TẢI APP NGAY ĐỂ KHÁM PHÁ
                </div>
                <div class="row text-center d-flex justify-content-center">
                    <div class="download-btn col text-right">
                        <a href="https://apps.apple.com/us/app/thecuatui/id1568831849"><img src="/assets/img/share_website/appstore.png" alt=""></a>
                    </div>
                    <div class="download-btn col text-left">
                        <a href="https://play.google.com/store/apps/details?id=com.thecuatui"><img src="/assets/img/share_website/googleplay.png" alt=""></a>
                    </div>
                </div>
            </div>           
        </div>
    </div>
    <div id="mobile" class="w-100 text-center">
        <div class="mobile-banner">
            <img style="border-radius: 50%;" src="<%= detail.avatar %>" alt="Banner">
        </div>
        <div class="author_name_mobile">
            <%= detail.name %>
        </div>
        <div class="text-mobile">
            Artist on RinZ Music
        </div>
        <div class="download-content-mobile">
            <div class="download-title-mobile">
                TẢI APP NGAY ĐỂ KHÁM PHÁ
            </div>
            <div class="row">
                <div class="download-btn-mobile col text-right">
                    <a href="https://apps.apple.com/us/app/thecuatui/id1568831849"><img src="/assets/img/share_website/appstore.png" alt=""></a>
                </div>
                <div class="download-btn-mobile col text-left">
                    <a href="https://play.google.com/store/apps/details?id=com.thecuatui"><img src="/assets/img/share_website/googleplay.png" alt=""></a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>