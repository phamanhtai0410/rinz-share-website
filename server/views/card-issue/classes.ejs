<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0">
    <meta name="turbolinks-cache-control" content="no-cache">
    <title>Card Issue</title>
    <link rel="icon" type="image/x-icon" href="/assets/img/thecuatui.png" />
    <!-- @font-face{
        font-family: Reef;
        src: local('../Fonts/Reef/reef-webfont.woff'), url('../Fonts/Reef/reef-webfont.woff') format('woff');
    } -->
    <!-- Google fonts-->
    <link href="/template/fonts/SVN-Gilroy.otf" rel='stylesheet' type='text/css' />
    <!-- <link href="https://fonts.googleapis.com/css?family=Lora:400,400i,700,700i" rel="stylesheet" /> -->
    <!-- Core theme CSS (includes Bootstrap)-->
    <link href="/template/css/styles.css" rel="stylesheet" />
    <link href="/template/css/styles.scss" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <!-- Latest compiled and minified CSS -->
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">

    <!-- jQuery library -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>

    <!-- Latest compiled JavaScript -->
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
    <style>
        @font-face {
            font-family: --font;
            src: url(/template/fonts/SVN-Gilroy.otf);
        }
        
        .text-title {
            font-weight: 700;
            color: #262626;
            font-size: 16px;
            line-height: 24px;
        }
        /* Demo styles */
        
        body {
            width: 100%;
            height: 100%;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            font-family: --font;
            background: transparent;
        }
        
         :root {
            --bg: #bd7171;
            --highlight1: #ED4264;
            --highlight2: #FFEDBC;
            --color: #1a1e24;
        }
        
        .container {
            max-width: 500px;
            overflow: hidden;
            border-radius: 26px 26px 0px 0px
        }
        
        .button {
            background: linear-gradient(90deg, #A34097 -1.69%, #ED2A5C 49.76%, #F05E2B 98.07%);
            border-radius: 8px;
            font-weight: 500;
            font-size: 16px;
            line-height: 24px;
            margin: 0px 12px;
            color: #FFFFFF;
        }
        
        .class-content {
            background: white;
            box-shadow: 0px 4px 20px rgb(0 0 0 / 6%);
        }
        
        .img-content {
            width: 100%;
            display: block;
            height: 150px;
        }
        
        .card-type {
            left: 50%;
            top: 50%;
            max-width: 40%;
            object-fit: contain;
        }
        
        .text-special {
            font-size: 14px;
            font-weight: 400;
            line-height: 22px;
            color: #F05E2B;
        }
        
        .text-normal {
            font-weight: 400;
            font-size: 14px;
            line-height: 22px;
        }
        
        .display-number {
            font-weight: bold;
            font-size: 18px;
            line-height: 28px;
            color: #EE3156;
        }
        
        .submit-class {
            margin: 10px 0px;
        }
        
        .hide-me[aria-expanded="true"] {
            display: none;
        }
        
        .text-btn {
            border-radius: 10px;
            font-weight: 500;
            font-size: 16px;
            line-height: 24px
        }
        
        .more {
            display: none;
        }
    </style>
</head>

<body>
    <section class="page-section d-flex justify-content-center w-100 mb-0">
        <div class="container">
            <% for(var i=0; i<classes.length; i++) {%>
                <div class='class-content pb-4 row d-flex justify-content-center'>
                    <div class="img-content d-flex justify-content-center pt-5 pb-3">
                        <img class='card-type' src="<%= classes[i].images[0] %>" alt="No demo card image...">
                    </div>
                    <div class="class-name row">
                        <div class="text-center text-title">
                            <%= classes[i].class_name %>
                        </div>
                    </div>
                    <div class="class-special row pb-3">
                        <span> </span>
                        <div class="text-left text-special">
                            <% if (classes[i].special.split('/n').length > 1) {%>
                                <ul style="list-style: none;">
                                    <% for(var j=0; j<classes[i].special.split('/n').length; j++) {%>
                                        <li>
                                            <%= classes[i].special.split('/n')[j] %>
                                        </li>
                                        <% } %>
                                </ul>
                                <% } else {%>
                                    <%= classes[i].special %>
                                        <% } %>
                        </div>
                    </div>
                    <div class='class-detail row p-3 d-flex justify-content-center'>
                        <div class="row py-3 px-2" style="box-shadow: 0px 4px 20px rgba(0, 0, 0, 0.04);">
                            <div class='col text-left' style="border-right: 1px dashed #D9D9D9;">
                                <div class="text-normal">
                                    Lãi suất
                                </div>
                                <div class='display-number'>
                                    <% if (classes[i].interest_year.split('/n').length > 1) {%>
                                        <ul style='list-style: none;'>
                                            <% for(var j=0; j<classes[i].special.split('/n').length; j++) {%>
                                                <li>
                                                    <%= classes[i].interest_year.split('/n')[j] %>
                                                </li>
                                                <% } %>
                                        </ul>
                                        <% } else {%>
                                            <%= classes[i].interest_year %>
                                                <% } %>

                                </div>
                            </div>

                            <div class='col text-left'>
                                <div class="text-normal">
                                    Phí thường niên
                                </div>
                                <div class='display-number'>
                                    <%= classes[i].annual_fees %>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row py-2">
                        <div id="show-more-content-<%= i %>" class="px-4 my-2">
                            <div>
                                <ul class='mb-0'>
                                    <% for(var j=0; j<3; j++) {%>
                                        <li class="text-normal">
                                            <%= classes[i].description.split('/n')[j] %>
                                        </li>
                                        <% } %>
                                </ul>
                                <% if (classes[i].description.split('/n').length > 3) { %>
                                    <span id='dots-<%= i %>'>...</span>
                                    <% } %>


                                        <ul id='more-<%= i %>' class='more'>
                                            <% for(var j=3; j<classes[i].description.split('/n').length; j++) {%>
                                                <li class="text-normal">
                                                    <%= classes[i].description.split('/n')[j] %>
                                                </li>
                                                <% } %>
                                        </ul>

                            </div>
                            <div class="text-center">
                                <% if (classes[i].description.split('/n').length > 3) { %>
                                    <button onclick="show_more_function('<%= i %>')" type="button" class="btn btn-link text-normal" id='show-more-<%=i %>'>Xem thêm</button>
                                    <% } %>
                            </div>

                        </div>
                    </div>

                    <div class="submit-class row d-flex justify-content-center">
                        <a href="/card-issue/card-register?bank_code=<%= bank_code %>&class_id=<%= classes[i].id %>&token=<%= token %>" class="btn w-100 mb-1 button text-btn py-3">Đăng ký ngay</a>
                    </div>
                </div>
                <% } %>
        </div>


    </section>
    <script>
        $(document).ready(function() {
            // document.getElementsByClassName("hide-me[aria-expanded=true]").previousSibling.style.display = 'none ';

        });

        function show_more_function(i) {
            var dots = document.getElementById("dots-" + i);
            var moreText = document.getElementById("more-" + i);
            var btnText = document.getElementById("show-more-" + i);

            if (dots.style.display === "none") {
                dots.style.display = "inline";
                btnText.innerHTML = "Xem thêm";
                moreText.style.display = "none";
            } else {
                dots.style.display = "none";
                btnText.innerHTML = "Thu gọn";
                moreText.style.display = "block";
            }
        }
    </script>
</body>

</html>