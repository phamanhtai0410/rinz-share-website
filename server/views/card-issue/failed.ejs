<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0">
    <meta name="turbolinks-cache-control" content="no-cache">
    <title>Card Issue</title>
    <link rel="icon" type="image/x-icon" href="/assets/img/thecuatui.png" />
    <!-- @font-face{
        font-family: Reef;
        src: local('../Fonts/Reef/reef-webfont.woff'), url('../Fonts/Reef/reef-webfont.woff') format('woff');
    } -->
    <!-- Google fonts-->
    <link href="/template/fonts/SVN-Gilroy.otf" rel='stylesheet' type='text/css' />
    <!-- <link href="https://fonts.googleapis.com/css?family=Lora:400,400i,700,700i" rel="stylesheet" /> -->
    <!-- Core theme CSS (includes Bootstrap)-->
    <link href="/template/css/styles.css" rel="stylesheet" />
    <link href="/template/css/styles.scss" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <!-- Latest compiled and minified CSS -->
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">

    <!-- jQuery library -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>

    <!-- Latest compiled JavaScript -->
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
    <style>
        @font-face {
            font-family: --font;
            src: url(/template/fonts/SVN-Gilroy.otf);
        }
        
        .text-title {
            font-weight: 700;
            color: #262626;
            font-size: 16px;
            line-height: 24px;
        }
        /* Demo styles */
        
        body {
            width: 100%;
            height: 100%;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            font-family: --font;
        }
        
         :root {
            --bg: #bd7171;
            --highlight1: #ED4264;
            --highlight2: #FFEDBC;
            --color: #1a1e24;
        }
        
        .container {
            border-radius: 20px;
            max-width: 500px;
            overflow: hidden;
        }
        
        .button {
            background: linear-gradient(90deg, #A34097 -1.69%, #ED2A5C 49.76%, #F05E2B 98.07%);
            border-radius: 8px;
            font-weight: 500;
            font-size: 16px;
            line-height: 24px;
            margin: 0px 12px;
            color: #FFFFFF;
        }
        
        .class-content {
            border-radius: 26px;
            background: white;
            box-shadow: 0px 4px 20px rgb(0 0 0 / 6%);
        }
        
        .img-content {
            width: 100%;
            display: block;
            max-height: 30%;
        }
        
        .card-type {
            left: 50%;
            top: 50%;
            max-width: 40%;
        }
        
        .text-special {
            font-size: 14px;
            font-weight: 400;
            line-height: 22px;
            color: #F05E2B;
        }
        
        .text-normal {
            font-weight: 400;
            font-size: 14px;
            line-height: 22px;
        }
        
        .display-number {
            font-weight: bold;
            font-size: 19px;
            line-height: 28px;
            color: #EE3156;
        }
        
        .submit-class {
            margin: 10px 0px;
        }
        
        .text-big {
            font-weight: 500;
            font-size: 30px;
            line-height: 38px;
        }
        
        .kyc-header {
            background: linear-gradient( 90deg, #A34097 -1.69%, #ED2A5C 49.76%, #F05E2B 98.07%);
            border-bottom-left-radius: 50% 30px;
            border-bottom-right-radius: 50% 30px;
            color: white;
        }
        
        .kyc-items {
            border: 1px solid #E8E8E8;
            box-sizing: border-box;
            border-radius: 8px;
        }
        
        .text-label {
            font-weight: normal;
            font-size: 12px;
            line-height: 16px;
            color: #8C8C8C;
        }
        
        .thank-you {
            font-weight: 500;
            font-size: 20px;
            line-height: 28px;
        }
    </style>
</head>

<body>
    <section class="page-section d-flex align-items-center w-100 mb-0" style="min-height: 800px;width: inherit;align-items: center;background: white;">
        <div class="container px-4" style="background: white;align-items: center;">
            <div class='icon-status text-center py-4 d-flex justify-content-center'>
                <div style="border: 20px solid #ee8780;
                            border-radius: 50%;">
                    <div style="border-radius: 50%;border: 20px solid #b62e05;">
                        <i class="fa fa-exclamation-triangle fa-2x" aria-hidden="true" style="border: 3px solid #b62e05;
                                                                                background: #b62e05;
                                                                                color: white;"></i>
                    </div>
                </div>
            </div>
            <div class='thank-you text-center py-4'>
                Cập nhật thông tin đăng ký mở thẻ cùng Thecuatui không thành công !!!
            </div>
            <div class="text-normal text-center py-4">
                <%= status %> !!!
                    <%= error %>
            </div>
            <div class="pt-5 d-flex justify-content-center w-100">
                <button type="button" class="button w-100 p-3" style="border: none;" onclick="goBack()">
                    <strong style="color: white;">
                        <i class="fa fa-arrow-left fa-lg" aria-hidden="true"></i>
                        Trở lại form nhập thông tin
                    </strong>
                </button>
            </div>
        </div>


    </section>
    <script>
        function goBack() {
            window.history.back();
        }
    </script>
</body>

</html>