<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0">
    <meta name="turbolinks-cache-control" content="no-cache">
    <title>Card Issue</title>
    <link rel="icon" type="image/x-icon" href="/assets/img/thecuatui.png" />
    <!-- @font-face{
        font-family: Reef;
        src: local('../Fonts/Reef/reef-webfont.woff'), url('../Fonts/Reef/reef-webfont.woff') format('woff');
    } -->
    <!-- Google fonts-->
    <link href="/template/fonts/SVN-Gilroy.otf" rel='stylesheet' type='text/css' />
    <!-- <link href="https://fonts.googleapis.com/css?family=Lora:400,400i,700,700i" rel="stylesheet" /> -->
    <!-- Core theme CSS (includes Bootstrap)-->
    <link href="/template/css/styles.css" rel="stylesheet" />
    <link href="/template/css/styles.scss" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <!-- Latest compiled and minified CSS -->
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">

    <!-- jQuery library -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>



    <!-- Latest compiled JavaScript -->
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
    <style>
        @font-face {
            font-family: --font;
            src: url(/template/fonts/SVN-Gilroy.otf);
        }
        
        .text-title {
            font-weight: 700;
            color: #262626;
            font-size: 16px;
            line-height: 24px;
        }
        /* Demo styles */
        
        body {
            width: 100%;
            height: 100%;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: --font;
        }
        
         :root {
            --bg: #bd7171;
            --highlight1: #ED4264;
            --highlight2: #FFEDBC;
            --color: #1a1e24;
        }
        
        .container {
            max-width: 500px;
            overflow: hidden;
        }
        
        .button {
            background: linear-gradient(90deg, #A34097 -1.69%, #ED2A5C 49.76%, #F05E2B 98.07%);
            border-radius: 8px;
            font-weight: 500;
            font-size: 16px;
            line-height: 24px;
            margin: 0px 12px;
            color: #FFFFFF;
        }
        
        .class-content {
            border-radius: 26px;
            background: white;
            box-shadow: 0px 4px 20px rgb(0 0 0 / 6%);
        }
        
        .img-content {
            width: 100%;
            display: block;
            max-height: 30%;
        }
        
        .card-type {
            left: 50%;
            top: 50%;
            max-width: 40%;
        }
        
        .text-special {
            font-size: 14px;
            font-weight: 400;
            line-height: 22px;
            color: #F05E2B;
        }
        
        .text-normal {
            font-weight: 400;
            font-size: 14px;
            line-height: 22px;
        }
        
        .display-number {
            font-weight: bold;
            font-size: 19px;
            line-height: 28px;
            color: #EE3156;
        }
        
        .submit-class {
            margin: 10px 0px;
        }
        
        .text-big {
            font-weight: 500;
            font-size: 30px;
            line-height: 38px;
        }
        
        .kyc-header {
            background: linear-gradient( 90deg, #A34097 -1.69%, #ED2A5C 49.76%, #F05E2B 98.07%);
            border-bottom-left-radius: 50% 30px;
            border-bottom-right-radius: 50% 30px;
            color: white;
        }
        
        .kyc-items {
            border: 1px solid #E8E8E8;
            box-sizing: border-box;
            border-radius: 8px;
        }
        
        .text-label {
            font-weight: normal;
            font-size: 12px;
            line-height: 16px;
            color: #8C8C8C;
        }
        
        #loader {
            transition: all 0.3s ease-in-out;
            opacity: 1;
            visibility: visible;
            position: fixed;
            height: 100vh;
            width: 100%;
            background: #fff;
            z-index: 90000;
        }
        
        #pageloader {
            background: rgba( 255, 255, 255, 0.8);
            display: none;
            height: 100%;
            position: fixed;
            width: 100%;
            z-index: 9999;
        }
        
        #pageloader img {
            left: 50%;
            position: absolute;
            top: 50%;
            transform: translate(-50%, -50%);
        }
    </style>
</head>

<body style="align-items: baseline; background: white;">
    <div id="pageloader">
        <img src="/assets/img/loader.gif" alt="processing..." />
    </div>
    <section class="page-section d-flex justify-content-center w-100">
        <div class="container pb-4 shadow px-0" style="background: white;">
            <div class='kyc-header pb-5 pt-3 px-3'>
                <div class='text-big text-left'>
                    Bạn muốn mở thẻ tín dụng?
                </div>
                <div class="text-normal text-left">
                    Chỉ cần 1 phút để hoàn tất đăng ký
                </div>
            </div>
            <form class="kyc-content px-4" id='form-register'>
                <div class='kyc-items my-4'>
                    <div class="fullname" style="height: 60px;">
                        <div class="text-left text-label px-2 pt-2">
                            Họ và tên
                        </div>
                        <div class="px-3 py-2">
                            <div class='mb-4 w-100'>
                                <input required="" oninput="setCustomValidity('')" oninvalid="this.setCustomValidity('Hãy nhập họ tên !')" style='border:none;' placeholder='VD: Nguyễn Văn A' class='w-100' type="text" name="header-text" id="fullname" value=<%=fullname %>                                >
                            </div>
                        </div>
                    </div>
                </div>

                <div class='kyc-items my-4'>
                    <div class="phone" style="height: 60px;">
                        <div class="text-left text-label px-2 pt-2">
                            Số điện thoại
                        </div>
                        <div class="px-3 py-2">
                            <div class='mb-4 w-100'>
                                <input required oninput="setCustomValidity('')" oninvalid="this.setCustomValidity('Hãy nhập Số điện thoại !')" placeholder='VD: 0900000000' style='border: none;' class='w-100' type="text" name="header-text" id="phone" value=<%=phone %>                                >
                            </div>

                        </div>

                    </div>
                </div>
                <% for(var i=0; i<kyc.length; i++) {%>

                    <% if (kyc[i].question_type === 'combobox')  {%>
                        <div class='kyc-items my-4'>
                            <div class="combobox" style="height: 60px;">
                                <div class="text-left text-label px-2 pt-2">
                                    <%= kyc[i].title %>
                                </div>
                                <div class="px-3 py-2">
                                    <select required oninput="setCustomValidity('')" oninvalid="this.setCustomValidity('Hãy chọn một lựa chọn !')" class='mb-4 w-100' style="border: none;" name="<%= kyc[i].alias_id %>" id="<%= kyc[i].alias_id %>" <% if (kyc[i].multiple_selected===true) {%>
                                        multiple
                                    <% } %>
                                    >
                                        <option value=""></option>
                                    <% for (var j=0; j<kyc[i].options.length; j++) {%>
                                        <option value="<%= kyc[i].options[j].key %>"><%= kyc[i].options[j].value %></option>
                                    <% } %>
                                    </select>
                                </div>

                            </div>
                        </div>
                        <% } %>

                            <% if (kyc[i].question_type === 'currency') {%>
                                <div class='kyc-items my-4'>
                                    <div class="currency" style="height: 60px;">
                                        <div class="text-left text-label px-2 pt-2">
                                            <%= kyc[i].title %>
                                        </div>
                                        <div class="px-3 py-2 row">
                                            <div class='mb-4 px-4' id='input_currency'>
                                                <input required oninput="setCustomValidity('')" oninvalid="this.setCustomValidity('Hãy nhập <%= kyc[i].title %> !')" style='border: none; width: 100%;' type="text" data-a-sign="" data-a-dec="." data-a-sep="," name="currency" id="<%= kyc[i].alias_id %>">
                                            </div>
                                            <div class='' id='currency' style="visibility:hidden;">VNĐ</div>
                                        </div>
                                    </div>
                                </div>
                                <% } %>




                                    <% if (kyc[i].question_type === 'single')  { %>
                                        <div class='kyc-items my-4' style='border: none;'>
                                            <div class="single" style="height: 60px;">
                                                <div class="text-left text-label px-2 pt-2">
                                                    <%= kyc[i].title %>
                                                </div>
                                                <div class="px-3 py-2">
                                                    <div class='mb-4 w-100 row'>
                                                        <% for (var j=0; j<kyc[i].option.length; j++) { %>
                                                            <div class="form-check col-6 px-4">
                                                                <input class="form-check-input" type="radio" name="<%= kyc[i].alias_id %>" id="<%= kyc[i].alias_id %>-<%= j %>" value="<%= kyc[i].option[j].key %>" <% if (j===0 ) { %> required oninvalid="this.setCustomValidity('Hãy
                                                                chọn một lựa chọn !')" oninput="setCustomValidity('')"
                                                                <% } %>
                                                                    >

                                                                    <label class="form-check-label" for="<%= kyc[i].alias_id %>-<%= j %>"><%= kyc[i].option[j].value %></label>
                                                            </div>
                                                            <% } %>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <% } %>
                                            <% } %>
                                                <div class="submit-class row d-flex justify-content-center">
                                                    <input type="submit" id="submit1" class="btn w-100 mb-1 button py-3" style="color:white; border-radius: 10px;" value="Đăng ký ngay">
                                                </div>


            </form>
        </div>


    </section>
    <script>
        // Loader event handler



        (function($, undefined) {

            "use strict";

            // When ready.
            $(function() {

                var $form = $('#form-register');
                var $input = $('input[name=currency]');

                $input.on("keyup", function(event) {


                    // When user select text in the document, also abort.
                    var selection = window.getSelection().toString();
                    if (selection !== '') {
                        return;
                    }

                    // When the arrow keys are pressed, abort.
                    if ($.inArray(event.keyCode, [38, 40, 37, 39]) !== -1) {
                        return;
                    }


                    var $this = $(this);

                    // Get the value.
                    var input = $this.val();

                    var input = input.replace(/[\D\s\._\-]+/g, "");
                    input = input ? parseInt(input, 10) : 0;

                    $this.val(function() {
                        return (input === 0) ? "" : input.toLocaleString("en-US");
                    });
                });

            });
        })(jQuery);

        $(document).ready(function() {
            $("#txt_show_ajax_response").text(function(i, oldtext) {
                return oldtext + '- init doc ';
            });

            $('input[name=currency]').on('input', function() {
                if ($('input[name=currency]').val() !== "") {
                    $('#currency').css('visibility', 'visible');
                    $('#input_currency').addClass('col-10');
                    $('#currency').addClass('col');
                } else {
                    $('#currency').css('visibility', 'hidden');
                    $('#input_currency').removeClass('col-10');
                    $('#currency').removeClass('col');
                }
            });

            ReactNativeWebView.postMessage('Show Form');
        });



        $('#form-register').submit(function(e) {

            "use strict";
            e.preventDefault();

            $("#pageloader").fadeIn();

            console.log('class_id : ' + '<%=class_id%>');
            var data = {
                class_id: '<%=class_id%>'
            };

            $('.kyc-items input[name=header-text]').each(function() {
                data[this.id] = this.value;
            });

            $('.kyc-items input[name=currency]').each(function() {


                // data[this.id] = this.value.replaceAll(",", '');
                var value_currency = this.value.replace(",", "");
                value_currency = value_currency.replace(",", "");
                value_currency = value_currency.replace(",", "");
                value_currency = value_currency.replace(",", "");
                value_currency = value_currency.replace(",", "");

                data[this.id] = value_currency;

            });

            $('.kyc-items select').each(function() {
                data[this.id] = this.value;
            });

            $('input[type=radio]:checked').each(function() {
                data[this.name] = this.value;
            });

            var url = '/card-issue/card-register/submit?token=<%=token%>'; // the script where you handle the form input.
            console.log('url ajax = ' + url);
            console.log('data post : ' + JSON.stringify(data));


            // before send
            $("body").addClass("loading");

            $.ajax({
                type: "POST",
                url: url,
                timeout: 5000,
                dataType: "json",
                data: JSON.stringify(data),
                beforeSend: function(xhr) {
                    xhr.setRequestHeader('Content-Type', 'application/json');
                },
                success: function(data) {
                    //if request successful

                    $("body").removeClass("loading");
                    if (data.status === 1) {
                        location.assign("/card-issue/card-register/show-result?result=success");
                    } else {
                        location.assign("/card-issue/card-register/show-result?result=failed&status=none");
                    }
                    console.log('success ajax = ' + data);
                },
                error: function(request, status, error) {

                    $("body").removeClass("loading");

                    //if request unsuccessful
                    if (status == "timeout") {
                        // timeout -> reload the page and try again
                        clearInterval(ajax_call);
                        location.assign("/card-issue/card-register/show-result?result=failed&status=timeout");
                    } else {

                        // another error occured  
                        // alert("error: " + request + status + err);
                        location.assign("/card-issue/card-register/show-result?result=failed&status=" + status + '&error=' + error);
                    }
                    // console.log('record - error data =' + JSON.stringify(data));
                    // alert('!');

                }
            });
        });
    </script>
</body>

</html>